{
  "experiment_id": "gr_tangent_c_port_validation_v1",
  "title": "Serial compiled-C gr_potential tangent validation",
  "description": "Predetermined correctness, lifecycle, restart, reproducibility, performance, and capped-run matrix against frozen tag gr-tangent-python-oracle-v2.",
  "variables": {
    "PROJECT_ROOT": "/home/peacelovephysics/ephemeris",
    "OUTPUT_ROOT": "/home/peacelovephysics/ephemeris/output/stability/gr_tangent_c_port_validation_v1",
    "KERNEL": "/home/peacelovephysics/ephemeris/data/de431_part-2.bsp",
    "PYTHON": "/home/peacelovephysics/ephemeris/.venv/bin/python",
    "PYTHONPATH": "/home/peacelovephysics/ephemeris/mini_ephemeris/src:/home/peacelovephysics/ephemeris/ephemeris_experiment_runner/src"
  },
  "state_dir": "${OUTPUT_ROOT}/runner_state/gr_tangent_c_port_validation_v1",
  "execution_policy": {
    "serial": true,
    "maximum_integration_duration_years": 100000,
    "production_duration_authorization_flag_forbidden": true,
    "no_10myr_launch": true,
    "thresholds_frozen_before_decisive_runs": true
  },
  "thresholds": {
    "pointwise_acceleration_relative": 5e-14,
    "pointwise_acceleration_absolute": 1e-22,
    "pointwise_translation_relative": 1e-12,
    "pointwise_jacobian_relative": 1e-13,
    "pointwise_linearity_relative": 2e-13,
    "short_real_scaled_phase": 1e-10,
    "short_tangent_relative": 1e-8,
    "short_tangent_direction_cosine_min": 0.99999999,
    "finite_difference_relative_ceiling": 1e-4,
    "full_100k_real_scaled_phase": 1e-7,
    "full_100k_tangent_relative": 1e-5,
    "restart_physical_scaled_phase": 1e-10,
    "restart_tangent_relative": 1e-8,
    "restart_diagnostic_absolute": 1e-12,
    "reproducibility": "bitwise exact",
    "minimum_c_speedup": 2.0,
    "maximum_c_to_python_wall_ratio": 0.5
  },
  "stages": [
    {
      "id": "build_integrity",
      "objective": "Build/load the backend, verify ABI/API and protected-oracle integrity, and reject stale artifacts.",
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/build_integrity",
      "target_years": 0,
      "maximum_allowed_duration_years": 0,
      "inputs": ["C source", "installed rebound.h", "frozen oracle tag"],
      "seed": null,
      "expected_sample_count": 0,
      "required_artifacts": ["${OUTPUT_ROOT}/build_integrity/build_integrity_summary.json"],
      "tolerances": {"ABI": "exact", "oracle": "byte exact", "compiler_warnings": 0},
      "pass_rule": "forced clean build/load, symbols, ABI, stale rejection, and oracle integrity all pass",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/build_integrity", "build-integrity"],
      "gates": [{"kind": "json_metrics", "name": "build passed", "patterns": ["${OUTPUT_ROOT}/build_integrity/build_integrity_summary.json"], "checks": [{"path": "passed", "allowed": [true]}]}]
    },
    {
      "id": "pointwise_acceleration",
      "objective": "Match frozen-oracle acceleration over production-like, covariance, edge, and zero cases.",
      "depends_on": ["build_integrity"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/pointwise_acceleration",
      "target_years": 0,
      "maximum_allowed_duration_years": 0,
      "inputs": ["seed 20260804", "1-9 planets", "0.25-40 AU", "edge/zero/covariance cases"],
      "seed": 20260804,
      "expected_sample_count": 98,
      "required_artifacts": ["${OUTPUT_ROOT}/pointwise_acceleration/pointwise_acceleration_summary.json"],
      "tolerances": {"relative": 5e-14, "absolute": 1e-22, "central_relative": 5e-14, "translation_relative": 1e-12},
      "pass_rule": "all physical acceleration and covariance metrics pass",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/pointwise_acceleration", "pointwise-acceleration"],
      "gates": [{"kind": "json_metrics", "name": "acceleration passed", "patterns": ["${OUTPUT_ROOT}/pointwise_acceleration/pointwise_acceleration_summary.json"], "checks": [{"path": "passed", "allowed": [true]}]}]
    },
    {
      "id": "pointwise_jacobian",
      "objective": "Match the analytic Jacobian action over basis, random, linearity, covariance, central, and zero cases.",
      "depends_on": ["pointwise_acceleration"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/pointwise_jacobian",
      "target_years": 0,
      "maximum_allowed_duration_years": 0,
      "inputs": ["seed 20260805", "basis/random/mixed tangent vectors", "linearity/covariance cases"],
      "seed": 20260805,
      "expected_sample_count": 98,
      "required_artifacts": ["${OUTPUT_ROOT}/pointwise_jacobian/pointwise_jacobian_summary.json"],
      "tolerances": {"relative": 1e-13, "linearity_relative": 2e-13, "rotation_relative": 2e-13, "translation_norm": 1e-30},
      "pass_rule": "all analytic Jacobian action, linearity, covariance, and exact-zero metrics pass",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/pointwise_jacobian", "pointwise-jacobian"],
      "gates": [{"kind": "json_metrics", "name": "Jacobian passed", "patterns": ["${OUTPUT_ROOT}/pointwise_jacobian/pointwise_jacobian_summary.json"], "checks": [{"path": "passed", "allowed": [true]}]}]
    },
    {
      "id": "hot_path_lifecycle",
      "objective": "Prove direct C callback installation, C-owned instrumentation, and independent lifecycle state.",
      "depends_on": ["pointwise_jacobian"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/hot_path_lifecycle",
      "target_years": 0,
      "maximum_allowed_duration_years": 0,
      "inputs": ["two independently configured REBOUND simulations"],
      "seed": null,
      "expected_sample_count": 2,
      "required_artifacts": ["${OUTPUT_ROOT}/hot_path_lifecycle/hot_path_lifecycle_summary.json"],
      "tolerances": {"callback_address": "exact", "counter_isolation": "exact", "nonfinite_count": 0},
      "pass_rule": "installed pointer equals exported C symbol, C counters execute, Python wrapper absent, simulation state independent",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/hot_path_lifecycle", "hot-path-lifecycle"],
      "gates": [{"kind": "json_metrics", "name": "hot path passed", "patterns": ["${OUTPUT_ROOT}/hot_path_lifecycle/hot_path_lifecycle_summary.json"], "checks": [{"path": "passed", "allowed": [true]}, {"path": "hot_path_proof.addresses_match", "allowed": [true]}]}]
    },
    {
      "id": "short_dynamic_equivalence",
      "objective": "Establish short C/Python trajectory, tangent, MEGNO, and LCN equivalence with required controls.",
      "depends_on": ["hot_path_lifecycle"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/short_dynamic_equivalence",
      "target_years": 100,
      "maximum_allowed_duration_years": 100,
      "inputs": ["DE431", "2000-01-01", "two-body/full with and without Pluto", "0.5/1 day WHFast"],
      "seed": [12345, 67890],
      "expected_sample_count": 55,
      "required_artifacts": ["${OUTPUT_ROOT}/short_dynamic_equivalence/short_dynamic_equivalence_summary.json"],
      "tolerances": {"real_scaled_phase": 1e-10, "tangent_relative": 1e-8, "cosine_min": 0.99999999, "megno_absolute": 1e-7, "lcn_absolute": 1e-10},
      "pass_rule": "every matched C/Python short configuration passes every metric",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/short_dynamic_equivalence", "short-dynamic"],
      "gates": [{"kind": "json_metrics", "name": "short dynamics passed", "patterns": ["${OUTPUT_ROOT}/short_dynamic_equivalence/short_dynamic_equivalence_summary.json"], "checks": [{"path": "passed", "allowed": [true]}]}]
    },
    {
      "id": "finite_difference_oracle",
      "objective": "Use centered finite differences only as an independent local directional check.",
      "depends_on": ["short_dynamic_equivalence"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/finite_difference_oracle",
      "target_years": 10,
      "maximum_allowed_duration_years": 10,
      "inputs": ["accepted archive snapshots at 0/500k/1M years", "10 fixed epsilon values"],
      "seed": [10000, 510000, 1010000],
      "expected_sample_count": 60,
      "required_artifacts": ["${OUTPUT_ROOT}/finite_difference_oracle/finite_difference_oracle_summary.json"],
      "tolerances": {"relative_ceiling": 1e-4, "oracle_degradation_factor": 1.25, "absolute_slack": 5e-7, "cosine_min": 0.9999},
      "pass_rule": "every group has an adjacent convergence region and does not materially degrade from the accepted local oracle",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/finite_difference_oracle", "finite-difference-oracle"],
      "gates": [{"kind": "json_metrics", "name": "finite difference passed", "patterns": ["${OUTPUT_ROOT}/finite_difference_oracle/finite_difference_oracle_summary.json"], "checks": [{"path": "passed", "allowed": [true]}]}]
    },
    {
      "id": "physical_controls",
      "objective": "Confirm isolated relativistic precession, C/Python agreement, and the Newtonian zero limit.",
      "depends_on": ["finite_difference_oracle"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/physical_controls",
      "target_years": 100,
      "maximum_allowed_duration_years": 100,
      "inputs": ["isolated Sun-Mercury", "full-with-Pluto zero scale"],
      "seed": 12345,
      "expected_sample_count": 4,
      "required_artifacts": ["${OUTPUT_ROOT}/physical_controls/physical_controls_summary.json"],
      "tolerances": {"isolated_excess_arcsec_per_century": [38, 48], "zero_limit_scaled_phase": 1e-12},
      "pass_rule": "C/Python isolated precession and zero-scale Newtonian controls pass",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/physical_controls", "physical-controls"],
      "gates": [{"kind": "json_metrics", "name": "physical controls passed", "patterns": ["${OUTPUT_ROOT}/physical_controls/physical_controls_summary.json"], "checks": [{"path": "passed", "allowed": [true]}]}]
    },
    {
      "id": "full_dynamic_physical_100k",
      "objective": "Compare full capped C/Python dynamics and paired custom/REBOUNDx secular behavior.",
      "depends_on": ["physical_controls"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/full_dynamic_physical_100k",
      "target_years": 100000,
      "maximum_allowed_duration_years": 100000,
      "status_interval_seconds": 120,
      "stall_warning_seconds": 1800,
      "inputs": ["matched C/Python/reboundx/Newtonian full-with-Pluto lanes", "1 day WHFast", "DE431"],
      "seed": 12345,
      "expected_sample_count": 101,
      "required_artifacts": ["${OUTPUT_ROOT}/full_dynamic_physical_100k/full_dynamic_physical_100k_summary.json", "${OUTPUT_ROOT}/full_dynamic_physical_100k/full_dynamic_physical_100k.csv"],
      "tolerances": {"real_scaled_phase": 1e-7, "tangent_relative": 1e-5, "cosine_min": 0.99999, "megno_absolute": 1e-5, "lcn_absolute": 1e-9, "paired_reboundx_gr_relative": 1e-4},
      "pass_rule": "C/Python tangent and physical state pass; paired GR-minus-Newtonian and secular elements remain within fixed C/REBOUNDx envelope",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/full_dynamic_physical_100k", "full-dynamic-physical"],
      "progress_sources": [{"kind": "csv", "path_globs": ["${OUTPUT_ROOT}/full_dynamic_physical_100k/full_dynamic_physical_100k.csv"]}],
      "gates": [{"kind": "json_metrics", "name": "full dynamics passed", "patterns": ["${OUTPUT_ROOT}/full_dynamic_physical_100k/full_dynamic_physical_100k_summary.json"], "checks": [{"path": "passed", "allowed": [true]}, {"path": "sample_count", "min": 101, "max": 101}]}]
    },
    {
      "id": "restart_equivalence_20000",
      "objective": "Validate fresh-process restart, diagnostics, counters, deduplication, and failure rejection at 20 kyr.",
      "depends_on": ["full_dynamic_physical_100k"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/restart_equivalence_20k",
      "target_years": 20000,
      "maximum_allowed_duration_years": 20000,
      "inputs": ["uninterrupted and split fresh-process C lanes", "4 day WHFast", "failure injection"],
      "seed": 12345,
      "expected_sample_count": 21,
      "required_artifacts": ["${OUTPUT_ROOT}/restart_equivalence_20k/restart_equivalence_20000_summary.json"],
      "tolerances": {"physical_scaled_phase": 1e-10, "tangent_relative": 1e-8, "cosine_min": 0.9999999999, "diagnostic_absolute": 1e-12},
      "pass_rule": "fresh-process continuation matches uninterrupted state/series/counters and rejects missing, truncated, and mismatched state",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/restart_equivalence_20k", "--restart-duration-years", "20000", "restart-equivalence"],
      "gates": [{"kind": "json_metrics", "name": "20 kyr restart passed", "patterns": ["${OUTPUT_ROOT}/restart_equivalence_20k/restart_equivalence_20000_summary.json"], "checks": [{"path": "passed", "allowed": [true]}, {"path": "fresh_process", "allowed": [true]}]}]
    },
    {
      "id": "restart_equivalence_100000",
      "objective": "Repeat the restart and failure-handling gate at the maximum allowed 100 kyr duration.",
      "depends_on": ["restart_equivalence_20000"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/restart_equivalence_100k",
      "target_years": 100000,
      "maximum_allowed_duration_years": 100000,
      "inputs": ["uninterrupted and split fresh-process C lanes", "4 day WHFast", "failure injection"],
      "seed": 12345,
      "expected_sample_count": 21,
      "required_artifacts": ["${OUTPUT_ROOT}/restart_equivalence_100k/restart_equivalence_100000_summary.json"],
      "tolerances": {"physical_scaled_phase": 1e-10, "tangent_relative": 1e-8, "cosine_min": 0.9999999999, "diagnostic_absolute": 1e-12},
      "pass_rule": "full capped fresh-process continuation matches uninterrupted state/series/counters and all failure handling passes",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/restart_equivalence_100k", "--restart-duration-years", "100000", "restart-equivalence"],
      "gates": [{"kind": "json_metrics", "name": "100 kyr restart passed", "patterns": ["${OUTPUT_ROOT}/restart_equivalence_100k/restart_equivalence_100000_summary.json"], "checks": [{"path": "passed", "allowed": [true]}, {"path": "fresh_process", "allowed": [true]}]}]
    },
    {
      "id": "reproducibility",
      "objective": "Require bitwise state, diagnostic, and instrumentation reproducibility.",
      "depends_on": ["restart_equivalence_100000"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/reproducibility",
      "target_years": 1000,
      "maximum_allowed_duration_years": 1000,
      "inputs": ["two fresh identical full-with-Pluto C simulations", "4 day WHFast"],
      "seed": 12345,
      "expected_sample_count": 22,
      "required_artifacts": ["${OUTPUT_ROOT}/reproducibility/reproducibility_summary.json"],
      "tolerances": {"state_and_diagnostics": "bitwise exact", "callback_stats": "exact"},
      "pass_rule": "both complete sampled trajectories and C-owned counters are bitwise reproducible",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/reproducibility", "reproducibility"],
      "gates": [{"kind": "json_metrics", "name": "reproducibility passed", "patterns": ["${OUTPUT_ROOT}/reproducibility/reproducibility_summary.json"], "checks": [{"path": "passed", "allowed": [true]}, {"path": "bitwise_equal", "allowed": [true]}]}]
    },
    {
      "id": "production_benchmark",
      "objective": "Measure matched end-to-end Python and C pathways against the fixed speed criterion.",
      "depends_on": ["reproducibility"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/production_benchmark",
      "target_years": 200,
      "maximum_allowed_duration_years": 200,
      "inputs": ["matched end-to-end Python and C full-with-Pluto lanes", "warm-up", "alternating order", "20 diagnostics"],
      "seed": 12345,
      "expected_sample_count": 200,
      "required_artifacts": ["${OUTPUT_ROOT}/production_benchmark/production_benchmark_summary.json"],
      "tolerances": {"minimum_speedup": 2.0, "maximum_c_to_python_ratio": 0.5, "tangent_relative": 1e-8},
      "pass_rule": "five-repetition median speedup and correctness criteria both pass",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/production_benchmark", "benchmark"],
      "gates": [{"kind": "json_metrics", "name": "benchmark passed", "patterns": ["${OUTPUT_ROOT}/production_benchmark/production_benchmark_summary.json"], "checks": [{"path": "passed", "allowed": [true]}, {"path": "speedup", "min": 2.0}, {"path": "c_to_python_wall_ratio", "max": 0.5}]}]
    },
    {
      "id": "capped_rehearsal_100k",
      "objective": "Run the C production lane to 100 kyr and audit health, continuity, archive readiness, and secular agreement.",
      "depends_on": ["production_benchmark"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/capped_rehearsal_100k",
      "target_years": 100000,
      "maximum_allowed_duration_years": 100000,
      "status_interval_seconds": 120,
      "stall_warning_seconds": 1800,
      "inputs": ["hardened C production runner", "accepted Python 100 kyr 1-day lane", "binary archive"],
      "seed": 12345,
      "expected_sample_count": 101,
      "required_artifacts": ["${OUTPUT_ROOT}/capped_rehearsal_100k/capped_rehearsal_100k_summary.json", "${OUTPUT_ROOT}/capped_rehearsal_100k/run/gr_tangent_archive_capped_rehearsal_100k.bin"],
      "tolerances": {"megno_absolute": 1e-5, "lcn_absolute": 1e-9, "mercury_a_au": 1e-8, "mercury_e": 1e-8, "mercury_varpi_deg": 1e-5, "nonfinite_count": 0},
      "pass_rule": "100 kyr C runner completes with 101 unique finite samples, direct hot path, archive reattachment readiness, and no unexplained C/Python secular divergence",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/capped_rehearsal_100k", "capped-rehearsal"],
      "progress_sources": [{"kind": "csv", "path_globs": ["${OUTPUT_ROOT}/capped_rehearsal_100k/run/gr_tangent_progress_*.csv"]}, {"kind": "archive", "path_glob": "${OUTPUT_ROOT}/capped_rehearsal_100k/run/*.bin", "archive_time_unit": "auto"}],
      "gates": [{"kind": "json_metrics", "name": "capped rehearsal passed", "patterns": ["${OUTPUT_ROOT}/capped_rehearsal_100k/capped_rehearsal_100k_summary.json"], "checks": [{"path": "passed", "allowed": [true]}, {"path": "sample_count", "min": 101, "max": 101}, {"path": "restart_ready", "allowed": [true]}]}]
    },
    {
      "id": "final_report",
      "objective": "Require every artifact and gate, then emit status, provenance, inventory, JSON, and Markdown.",
      "depends_on": ["capped_rehearsal_100k"],
      "cwd": "${PROJECT_ROOT}",
      "output_dir": "${OUTPUT_ROOT}/final_report",
      "target_years": 0,
      "maximum_allowed_duration_years": 0,
      "inputs": ["all 13 stage summaries", "manifest", "Git state", "environment and ABI"],
      "seed": null,
      "expected_sample_count": 14,
      "required_artifacts": ["${OUTPUT_ROOT}/final_report/gr_tangent_c_port_validation_summary.json", "${OUTPUT_ROOT}/final_report/gr_tangent_c_port_validation_report.md"],
      "tolerances": {"missing_or_unreadable_stages": 0, "failed_stages": 0, "duration_cap_years": 100000},
      "pass_rule": "all expected results readable and passing; oracle unchanged; cap respected; final_status READY_FOR_10MYR_C",
      "command": ["env", "PYTHONPATH=${PYTHONPATH}", "${PYTHON}", "-m", "mini_ephemeris.gr_tangent_c_validation", "--kernel-path", "${KERNEL}", "--output-dir", "${OUTPUT_ROOT}/final_report", "final-report"],
      "gates": [{"kind": "json_metrics", "name": "ready for 10 Myr C", "patterns": ["${OUTPUT_ROOT}/final_report/gr_tangent_c_port_validation_summary.json"], "checks": [{"path": "final_status", "allowed": ["READY_FOR_10MYR_C"]}, {"path": "validation.expected_stage_count", "min": 14, "max": 14}, {"path": "validation.passing_stage_count", "min": 14, "max": 14}, {"path": "duration_safety.cap_respected", "allowed": [true]}, {"path": "duration_safety.no_10myr_run_launched", "allowed": [true]}]}]
    }
  ]
}
