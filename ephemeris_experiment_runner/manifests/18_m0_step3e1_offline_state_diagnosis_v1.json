  "classification_rules": {
    "evaluation": "Evaluate every evidence predicate below. Select a non-mixed primary classification only when exactly one classification's complete required predicate set is true and no required analysis or integrity check failed. Otherwise select MIXED_OR_INCONCLUSIVE. Select NOT_EVALUATED only with BLOCKED.",
    "metric_or_representation_ill_conditioned": {
      "required": [
        "At least one frozen failed ratio is near-floor, cancellation-limited, or changes interpretation under a coordinate-free representation, or one frozen failed classical angle has condition amplification >= 10.",
        "The corresponding coordinate-free or nonsingular fine defect is smaller than the coarse defect in the full aggregate and in at least 8 of 10 fixed windows.",
        "The physical interpretation uses the unchanged stored states and no weakened threshold."
      ],
      "condition_amplification": "absolute wrapped classical-angle defect divided by max(coordinate-free angular defect, operational angular floor)",
      "small_denominator": "denominator <= 10 times the applicable operational floor",
      "window_cancellation": "a coarse window norm <= 0.25 times the median non-near-floor coarse window norm while adjacent fine windows remain non-near-floor"
    },
    "pointwise_predictability_floor": {
      "required": [
        "At least two early windows have aggregate defect cosine >= 0.5, positive projection, and identifiable positive Richardson order.",
        "At least three consecutive later windows have cosine < 0.5, nonpositive projection, or fewer than 25 percent identifiable pointwise orders.",
        "The transition window agrees within one 100 kyr window for the full system and at least two of Mercury, Venus, and Uranus.",
        "Spearman correlation between log tangent norm and log raw defect envelope after the transition is >= 0.7 for the full system or the bodies establishing the transition.",
        "Both phase-stripped methods and coordinate-free nonphase quantities show no persistent late nonphase nonconvergence.",
        "Frozen orbital, invariant, secular-frequency, perihelion-rate, MEGNO, and LCN conclusions remain unchanged."
      ]
    },
    "true_nonphase_nonconvergence": {
      "required": [
        "A coordinate-free shape or orientation fine/coarse aggregate ratio is >= 1 outside the operational floor.",
        "The same physical component is >= 1 in at least three consecutive windows whose right endpoints are >= 500 kyr.",
        "Both phase-stripping methods leave that component >= 1 in those windows.",
        "The component is neither near-floor nor representation-conditioned.",
        "Those windows retain positive coherent projection with cosine >= 0.5 or show a same-sign secular envelope slope in at least 8 of 10 windows."
      ]
    },
    "windowed_or_phase_dominated": {
      "required": [
        "The global transverse-position squared fraction is >= 0.75 or both phase alignments remove >= 50 percent of the global fine-defect squared norm.",
        "Both phase-stripped methods have full-history global fine/coarse ratio < 1, positive aggregate projection, and at least 8 of 10 global windows with ratio < 1.",
        "Both phase-stripped methods restore Mercury fine/coarse ratio < 1 and coordinate-free shape and orientation fine defects are smaller than coarse defects for every inner planet.",
        "The raw failed behavior is window dependent, defined as at least two ratio crossings of 1 or a maximum/minimum non-near-floor window ratio >= 2.",
        "No coordinate-free nonphase component meets TRUE_NONPHASE_NONCONVERGENCE."
      ]
    }
  },
