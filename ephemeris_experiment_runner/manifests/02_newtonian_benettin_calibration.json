            "${OUTPUT_ROOT}/full_with_pluto_newtonian_200myr_benettin_seed12345/stability_timeseries_*.csv"
          ]
        }
      ],
      "gates": [
        {
          "kind": "required_glob",
          "name": "summary exists",
          "patterns": [
            "${OUTPUT_ROOT}/full_with_pluto_newtonian_200myr_benettin_seed12345/benettin_summary_full_with_pluto_newtonian_benettin_200myr_seed12345.json"
          ],
          "min_count": 1
        },
        {
          "kind": "csv_integrity",
          "name": "time series complete",
          "patterns": [
            "${OUTPUT_ROOT}/full_with_pluto_newtonian_200myr_benettin_seed12345/*benettin*.csv",
            "${OUTPUT_ROOT}/full_with_pluto_newtonian_200myr_benettin_seed12345/*lyapunov*.csv",
            "${OUTPUT_ROOT}/full_with_pluto_newtonian_200myr_benettin_seed12345/stability_timeseries_*.csv"
          ],
          "target_years": 200000000,
          "min_rows": 2,
          "final_time_tolerance_fraction": 0.002
        }
      ]
    },
    {
