            "${OUTPUT_ROOT}/two_body_mercury_100kyr_seed67890/stability_timeseries_*.csv"
          ]
        }
      ],
      "gates": [
        {
          "kind": "required_glob",
          "name": "summary exists",
          "patterns": [
            "${OUTPUT_ROOT}/two_body_mercury_100kyr_seed67890/benettin_summary_two_body_mercury_newtonian_benettin_100kyr_seed67890.json"
          ],
          "min_count": 1
        },
        {
          "kind": "csv_integrity",
          "name": "time series complete",
          "patterns": [
            "${OUTPUT_ROOT}/two_body_mercury_100kyr_seed67890/*benettin*.csv",
            "${OUTPUT_ROOT}/two_body_mercury_100kyr_seed67890/*lyapunov*.csv",
            "${OUTPUT_ROOT}/two_body_mercury_100kyr_seed67890/stability_timeseries_*.csv"
          ],
          "target_years": 100000,
          "min_rows": 2,
          "final_time_tolerance_fraction": 0.002
        }
      ]
    },
    {
      "id": "full_pluto_10myr_seed12345",
      "title": "Full-with-Pluto 10 Myr false-positive control",
      "objective": "Confirm that the Benettin path remains regular-looking during the same short interval in which native Newtonian MEGNO stayed near two.",
      "depends_on": [
